# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。

# Financial Modeling Prep（必填：新闻、报价、财务数据）
FMP_API_KEY=

# OpenAI（默认配置必填：新闻分诊、thesis 更新、每日筛选用 GPT-6 Luna / Sol，按 token 付费）
OPENAI_API_KEY=

# Claude API（可选：只有某个环节设成 provider: claude 时才需要）
# 注意：深度研究默认走 Claude Code 订阅，不需要这个 key；
# 就算这里填了，机器人调用 claude 命令行时也会把它去掉，确保走订阅。
ANTHROPIC_API_KEY=

# Grok（可选：只有 sources.grok_scout: true 时需要）
XAI_API_KEY=

# 可选：通知推送到 Slack / Discord 的 webhook 地址
TRADEBOT_WEBHOOK_URL=

# 实盘保险栓：只有同时设置 execution.allow_live: true 和这里的 YES 才能连 IBKR 实盘
# TRADEBOT_LIVE=YES
# 实盘自动下单（不经过人工审批）还需要再加这一行
# TRADEBOT_AUTO_LIVE=YES
