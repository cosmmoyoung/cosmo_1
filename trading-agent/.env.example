# 复制这个文件为 .env(或在 GitHub Actions 里配成 Secrets),按需填写。
# 所有 key 都是可选的:一个都不填,系统也能用免费数据 + 规则引擎跑通。

# ---- LLM 分析(强烈推荐,这是整个系统的大脑)----
# 申请:https://console.anthropic.com  成本:日报模式约 $3-15/月
ANTHROPIC_API_KEY=

# ---- 行情数据(可选,不填则用 Yahoo Finance 免费接口)----
# 申请:https://site.financialmodelingprep.com  免费档每天 250 次调用够用
FMP_API_KEY=

# ---- X (Twitter) 大佬追踪(可选,最贵的一项)----
# 申请:https://developer.x.com  Basic 档 $200/月,读 1 万条/月
# 不填则跳过 X 抓取,用 RSS 新闻替代(免费,MVP 阶段推荐)
X_BEARER_TOKEN=

# ---- Telegram 推送(免费,推荐)----
# 1. 在 Telegram 搜 @BotFather,发 /newbot 创建机器人,拿到 token
# 2. 给你的机器人发一条消息,然后访问
#    https://api.telegram.org/bot<TOKEN>/getUpdates 找到你的 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 邮件推送(可选)----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
